# --- Database ---
# Local dev default is SQLite (no setup needed). In staging/prod, point
# this at Postgres 16 + pgvector, e.g.:
# DATABASE_URL=postgresql+psycopg2://agfintax:agfintax@localhost:5432/agfintax
DATABASE_URL=sqlite:///./agfintax.db

# --- Redis (optional caching / rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- LLM provider: model-agnostic, ENV-driven ---
# This is the ONLY place the model/provider is chosen. Nothing in the
# codebase hardcodes claude-sonnet-4-6 or any other model.
# To use OpenAI instead, set:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Guardrail / usage ---
DAILY_MESSAGE_LIMIT_DEFAULT=50

# --- Official-source lookups (search_official_sources -> tavily_search rows) ---
# TAVILY_API_KEY=
